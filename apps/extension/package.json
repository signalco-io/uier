{
  "name": "@uier/extension",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "uier desktop browser extension for configured project sites",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "build:hosted-test": "node scripts/build.mjs --hosted-test",
    "test:package": "node scripts/prepare-package.mjs && UIER_EXTENSION_TEST_PACKAGE=1 playwright test",
    "store:assets": "node scripts/store-assets.mjs"
  },
  "dependencies": {
    "@signalco/ui-icons": "0.2.2",
    "@signalco/ui-primitives": "0.6.5",
    "@uier/brand": "workspace:*",
    "@uier/toolbar": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "geist": "1.9.2",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  }
}
