{
  "name": "@uier/extension",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "uier desktop browser extension for configured project sites",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "build:hosted-test": "node scripts/build.mjs --hosted-test",
    "test:package": "node scripts/prepare-package.mjs && UIER_EXTENSION_TEST_PACKAGE=1 playwright test",
    "store:assets": "node scripts/store-assets.mjs",
    "release:version": "node scripts/release-plan.mjs version"
  },
  "dependencies": {
    "@uier/extension-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
