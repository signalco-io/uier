# Optional locally. Azure Cosmos DB for the comments API; without it `next dev` and the e2e tests
# (UIER_LOCAL=1) keep comments in memory, lost on restart. Required on every deployment (set by Pulumi).
# An account key (production; locally an emulator or your own serverless account):
# COSMOSDB_CONNECTION_STRING=
# Or, instead of a key, Microsoft Entra ID with the deployment's Vercel OIDC token (preview deployments;
# the managed identity only trusts their tokens, so this doesn't work locally):
# COSMOSDB_ENDPOINT=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# Comments container in the `uierdata` database (default: comments)
# COSMOSDB_COMMENTS_CONTAINER=comments
# Key for guest names and rate-limit counter ids, at least 32 characters. Required on every deployment (set
# by Pulumi); locally a fixed development key is used when it is not set.
# UIER_COMMENTS_SECRET=
# App data container (users, workspaces, projects) in the same database (default: app)
# COSMOSDB_APP_CONTAINER=app
# Private Azure Blob screenshot storage (required when saving screenshots through Cosmos).
# Pulumi configures deployments; previews use existing Azure OIDC variables instead of a key.
# AZURE_SCREENSHOTS_ENDPOINT=https://<account>.blob.core.windows.net/
# AZURE_SCREENSHOTS_CONTAINER=screenshots
# AZURE_SCREENSHOTS_CONNECTION_STRING=
# Email (sign-in links). Without them `next dev` and the e2e tests only log emails and the sign-in page
# shows the link instead (preview deployments too). Required in production.
# ACS_CONNECTION_STRING=
# UIER_EMAIL_SENDER=DoNotReply@<id>.azurecomm.net
# Rewrite suggestions in the toolbar (Anthropic API). Without it /api/rewrite answers 503 and the toolbar says
# suggestions are not available. Production: set by Pulumi from the repository secret ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
# Base URL for links in emails; set by default on Vercel (uier.io / the deployment URL)
# UIER_BASE_URL=

# Connected services (server only). Production variables are managed by Pulumi from the single
# optional GitHub repository secret UIER_INTEGRATION_ENV; see docs/integration-setup.md.
# Pulumi generates stable encryption keys and k1 key ids automatically. Never copy production
# credentials to local or preview deployments. Local development uses separate provider apps.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_TOKEN_KEY=
# NOTION_TOKEN_KEY_ID=k1
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# LINEAR_TOKEN_KEY=
# LINEAR_TOKEN_KEY_ID=k1
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_APP_ID=
# SLACK_DISTRIBUTION_APPROVED=0
# SLACK_TOKEN_KEY=
# SLACK_TOKEN_KEY_ID=k1
# UIER_GITHUB_APP_ID=
# UIER_GITHUB_APP_SLUG=
# UIER_GITHUB_CLIENT_ID=
# UIER_GITHUB_CLIENT_SECRET=
# UIER_GITHUB_PRIVATE_KEY=
# UIER_GITHUB_WEBHOOK_SECRET=
# UIER_GITHUB_SETUP_KEY=
# UIER_GITHUB_SETUP_KEY_ID=k1
# For an explicit rotation, each key family also supports *_KEY_PREVIOUS and *_KEY_PREVIOUS_ID.
# Local runtime alone permits fixed test keys and localhost API overrides. The browser test config
# supplies these with isolated stubs. Production never accepts endpoint overrides from the secret map.
