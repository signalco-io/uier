{
  "name": "@uier/web",
  "description": "uier.io website and comments API",
  "homepage": "https://uier.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "node scripts/build-mcp-app.mjs && node scripts/copy-fonts.mjs && node scripts/copy-proof-pdf-assets.mjs && node scripts/copy-scalar.mjs && next dev -p ${PORT:-4004}",
    "build:clean": "node scripts/clean-build.mjs",
    "build:compile": "node scripts/build-mcp-app.mjs && node scripts/copy-fonts.mjs && node scripts/copy-proof-pdf-assets.mjs && node scripts/copy-scalar.mjs && next build && next-sitemap --config next-sitemap.config.cjs",
    "build": "node scripts/copy-toolbar.mjs && node ../../.github/scripts/search-index.mjs generate",
    "start": "next start -p ${PORT:-4004}",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
