{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "jsx": "react-jsx",
        "types": ["node"],
        "paths": {
            "@/src/*": ["./src/*"]
        },
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
