{
  "name": "@uier/extension-firefox",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "uier desktop Firefox extension using the shared extension runtime",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "build:hosted-test": "node scripts/build.mjs --hosted-test",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test scripts/*.test.mjs",
    "publish:store": "node scripts/publish.mjs",
    "lint:store": "web-ext lint --source-dir dist --no-config-discovery"
  },
  "dependencies": {
    "@uier/extension-core": "workspace:*"
  },
  "devDependencies": {
    "web-ext": "10.8.0"
  }
}
