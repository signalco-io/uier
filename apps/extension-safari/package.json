{
  "name": "@uier/extension-safari",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "uier desktop Safari extension using the shared extension runtime",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "build:hosted-test": "node scripts/build.mjs --hosted-test",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "xcode": "node scripts/xcode.mjs",
    "native:build": "node scripts/native.mjs",
    "publish:store": "node scripts/publish.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@uier/extension-core": "workspace:*"
  }
}
