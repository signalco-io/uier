{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": [".browserslistrc", ".github/scripts/search-index.mjs", ".github/indexnow.json"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "!.next/dev/**",
                "dist/**",
                "public/sitemap*.xml",
                "public/robots.txt",
                "public/search-index.json",
                "public/toolbar.js",
                "public/toolbar-fonts/**",
                "public/toolbar/**"
            ],
            "env": ["SITE_URL", "UIER_DEPLOYMENT_ENV", "VERCEL_ENV", "UIER_TOOLBAR_RETAIN_FROM", "GITHUB_SHA"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["build"],
            "env": ["PLAYWRIGHT_FULL", "PLAYWRIGHT_CROSS_BROWSER"],
            "outputs": ["test-results/**", "playwright-report/**"],
            "passThroughEnv": ["CI", "PORT", "PLAYWRIGHT_*"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": ["PORT"]
        }
    }
}
