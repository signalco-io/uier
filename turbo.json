{
    "$schema": "https://turborepo.com/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "!.next/dev/**",
                "dist/**",
                "public/sitemap*.xml",
                "public/robots.txt",
                "public/toolbar.js",
                "public/toolbar/**"
            ],
            "env": ["SITE_URL", "UIER_DEPLOYMENT_ENV", "VERCEL_ENV", "UIER_TOOLBAR_RETAIN_FROM"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["build"],
            "outputs": ["test-results/**", "playwright-report/**"],
            "passThroughEnv": ["CI", "PORT", "PLAYWRIGHT_*"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
