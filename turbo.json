{
    "$schema": "https://turborepo.com/schema.json",
    "globalDependencies": [".browserslistrc", "tsconfig.base.json"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!e2e/**", "!**/*.test.mjs", "!playwright*.ts"],
            "outputs": ["dist/**"]
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["build"],
            "env": ["PLAYWRIGHT_FULL", "PLAYWRIGHT_CROSS_BROWSER"],
            "outputs": ["test-results/**", "playwright-report/**"],
            "passThroughEnv": ["CI", "PORT", "PLAYWRIGHT_*"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": ["PORT"]
        }
    }
}
