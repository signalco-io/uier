{
    "name": "@uier/infra",
    "description": "uier.io infrastructure (Pulumi program)",
    "private": true,
    "license": "MIT",
    "type": "module",
    "main": "dist/index.js",
    "engines": {
        "node": "24.x"
    },
    "packageManager": "pnpm@12.16.1",
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "preview": "pnpm build && pulumi preview --stack organization/uier/uier-production",
        "test": "node --test tests/*.test.mjs"
    },
    "dependencies": {
        "@pulumi/azure-native": "3.29.0",
        "@pulumi/cloudflare": "6.23.1",
        "@pulumi/pulumi": "3.272.0",
        "@pulumi/random": "4.21.4",
        "@pulumiverse/vercel": "5.21.1"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "typescript": "7.0.2"
    }
}
