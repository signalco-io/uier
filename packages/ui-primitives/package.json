        "next": ">=15.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "next": "16.4.6",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "7.0.2"
    }
