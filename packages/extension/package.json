{
  "name": "@uier/extension-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Shared uier WebExtension runtime and browser packaging",
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@signalco/ui-icons": "0.2.2",
    "@signalco/ui-primitives": "0.6.5",
    "@uier/brand": "workspace:*",
    "@uier/toolbar": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "geist": "1.9.2",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "typescript": "7.0.2"
  },
  "exports": {
    "./build": "./scripts/build.mjs",
    "./validate": "./scripts/validate.mjs",
    "./package": "./scripts/package.mjs",
    "./protocol": "./src/protocol.ts",
    "./release": "./scripts/release.mjs"
  },
  "scripts": {
