{
    "name": "@uier/toolbar",
    "description": "uier review toolbar - comments overlay injected into reviewed pages (shadow DOM)",
    "homepage": "https://uier.io",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "exports": {
        "./realtime": {
            "types": "./src/realtime.ts",
            "default": "./dist/realtime.js"
        },
        ".": "./dist/index.js",
        "./bundle": "./dist/bundle.json",
        "./react": {
            "types": "./src/react.ts",
            "default": "./dist/react.js"
        },
        "./index.css": "./dist/index.css",
        "./screenshot-policy": {
            "types": "./src/screenshotPolicy.ts",
            "default": "./dist/screenshotPolicy.js"
        },
        "./page-state": {
            "types": "./src/pageState.ts",
            "default": "./dist/pageState.js"
        },
        "./mentions": {
            "types": "./src/mentions.ts",
            "default": "./dist/mentions.js"
        },
        "./drafts": {
            "types": "./src/hooks/draftStorage.ts",
            "default": "./dist/draftStorage.js"
        },
        "./feedback-context": {
            "types": "./src/feedbackContext.ts",
            "default": "./dist/feedbackContext.js"
        },
        "./extension": {
            "types": "./src/extension.ts",
            "default": "./src/extension.ts"
        },
        "./extension-contract": {
            "types": "./src/extensionContract.ts",
            "default": "./dist/extensionContract.js"
        },
        "./triage": {
            "types": "./src/triage.ts",
            "default": "./dist/triage.js"
        },
        "./verification": {
            "types": "./src/verification.ts",
            "default": "./dist/verification.js"
        }
    },
    "scripts": {
        "dev:build": "tsup --watch ./src --env.NODE_ENV development",
        "dev:serve": "serve dist --no-port-switching -l $((${PORT:-4004} + 1))",
        "dev": "pnpm run \"/^dev:.*/\"",
        "build": "tsup --minify --env.NODE_ENV production",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@enterwell/react-hooks": "0.7.0",
        "@signalco/hooks": "0.2.1",
        "@signalco/js": "0.1.0",
        "@signalco/ui": "0.2.10",
        "@signalco/ui-icons": "0.2.2",
        "@signalco/ui-primitives": "0.6.5",
        "@signalco/ui-themes-minimal": "0.1.3",
        "@tailwindcss/postcss": "4.3.5",
        "@tanstack/react-query": "5.105.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@uier/brand": "workspace:*",
        "browserslist": "4.29.5",
        "postcss": "8.5.32",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "serve": "14.2.6",
        "tailwindcss": "4.3.5",
        "tailwindcss-animate": "1.0.7",
        "tsup": "9.0.0",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "dependencies": {
        "modern-screenshot": "4.7.0"
    }
}
