{
    "name": "@uier/toolbar",
    "description": "uier review toolbar - comments overlay injected into reviewed pages (shadow DOM)",
    "homepage": "https://uier.io",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": "26.x"
    },
    "exports": {
        "./attachments": {
            "types": "./src/useAttachedImage.ts",
            "development": "./dist-dev/attachments.js",
            "default": "./dist/attachments.js"
        },
        "./realtime": {
            "types": "./src/realtime.ts",
            "development": "./dist-dev/realtime.js",
            "default": "./dist/realtime.js"
        },
        ".": {
            "development": "./dist-dev/index.js",
            "default": "./dist/index.js"
        },
        "./bundle": {
            "development": "./dist-dev/bundle.json",
            "default": "./dist/bundle.json"
        },
        "./react": {
            "types": "./src/react.ts",
            "development": "./dist-dev/react.js",
            "default": "./dist/react.js"
        },
        "./index.css": {
            "development": "./dist-dev/index.css",
            "default": "./dist/index.css"
        },
        "./screenshot-policy": {
            "types": "./src/screenshotPolicy.ts",
            "development": "./dist-dev/screenshotPolicy.js",
            "default": "./dist/screenshotPolicy.js"
        },
        "./page-state": {
            "types": "./src/pageState.ts",
            "development": "./dist-dev/pageState.js",
            "default": "./dist/pageState.js"
        },
        "./page-sections": {
            "types": "./src/pageSections.ts",
            "development": "./dist-dev/pageSections.js",
            "default": "./dist/pageSections.js"
        },
        "./mentions": {
            "types": "./src/mentions.ts",
            "development": "./dist-dev/mentions.js",
            "default": "./dist/mentions.js"
        },
        "./color-values": {
            "types": "./src/colorValues.ts",
            "development": "./dist-dev/colorValues.js",
            "default": "./dist/colorValues.js"
        },
        "./markdown": {
            "types": "./src/markdown.ts",
            "development": "./dist-dev/markdown.js",
            "default": "./dist/markdown.js"
        },
        "./editor": {
            "types": "./src/editor/index.ts",
            "development": "./dist-dev/editor.js",
            "default": "./dist/editor.js"
        },
        "./device-details": {
            "types": "./src/deviceDetails/index.tsx",
            "development": "./dist-dev/deviceDetails.js",
            "default": "./dist/deviceDetails.js"
        },
        "./drafts": {
            "types": "./src/hooks/draftStorage.ts",
            "development": "./dist-dev/draftStorage.js",
            "default": "./dist/draftStorage.js"
        },
        "./feedback-context": {
            "types": "./src/feedbackContext.ts",
            "development": "./dist-dev/feedbackContext.js",
            "default": "./dist/feedbackContext.js"
        },
        "./extension": {
            "types": "./src/extension.ts",
            "default": "./src/extension.ts"
        },
        "./extension-contract": {
            "types": "./src/extensionContract.ts",
            "development": "./dist-dev/extensionContract.js",
            "default": "./dist/extensionContract.js"
        },
        "./reactions": {
            "types": "./src/reactions.ts",
            "development": "./dist-dev/reactions.js",
            "default": "./dist/reactions.js"
        },
        "./triage": {
            "types": "./src/triage.ts",
            "development": "./dist-dev/triage.js",
            "default": "./dist/triage.js"
        },
        "./verification": {
            "types": "./src/verification.ts",
            "development": "./dist-dev/verification.js",
            "default": "./dist/verification.js"
        },
        "./agent-working": {
            "types": "./src/useAgentWorking.ts",
            "development": "./dist-dev/agentWorking.js",
            "default": "./dist/agentWorking.js"
        },
        "./agents": {
            "types": "./src/agents.ts",
            "development": "./dist-dev/agents.js",
            "default": "./dist/agents.js"
        },
        "./devices": {
            "types": "./src/devices.ts",
            "development": "./dist-dev/devices.js",
            "default": "./dist/devices.js"
        },
        "./keyboard": {
            "types": "./src/keyboard.ts",
            "development": "./dist-dev/keyboard.js",
            "default": "./dist/keyboard.js"
        },
        "./languages": {
            "types": "./src/languages.ts",
            "development": "./dist-dev/languages.js",
            "default": "./dist/languages.js"
        },
        "./drawing": {
            "types": "./src/drawing.ts",
            "development": "./dist-dev/drawing.js",
            "default": "./dist/drawing.js"
        },
        "./feedback-types": {
            "types": "./src/feedbackTypes.ts",
            "development": "./dist-dev/feedbackTypes.js",
            "default": "./dist/feedbackTypes.js"
        },
        "./toolbar-features": {
            "types": "./src/toolbarFeatures.ts",
            "development": "./dist-dev/toolbarFeatures.js",
            "default": "./dist/toolbarFeatures.js"
        },
        "./recordings": {
            "types": "./src/recordings.ts",
            "development": "./dist-dev/recordings.js",
            "default": "./dist/recordings.js"
        }
    },
    "scripts": {
        "dev:build": "tsup --watch ./src --env.NODE_ENV development",
        "dev:serve": "serve dist-dev --no-port-switching -l $((${PORT:-4004} + 1))",
        "dev": "pnpm run \"/^dev:.*/\"",
        "build": "tsup --minify --env.NODE_ENV production",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@enterwell/react-hooks": "0.7.0",
        "@signalco/hooks": "0.2.1",
        "@signalco/js": "0.1.0",
        "@signalco/ui": "0.2.10",
        "@signalco/ui-icons": "0.2.2",
        "@signalco/ui-primitives": "0.6.5",
        "@signalco/ui-themes-minimal": "0.1.3",
        "@tailwindcss/postcss": "4.3.5",
        "@tanstack/react-query": "5.107.1",
        "@tanstack/react-virtual": "3.14.26",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@uier/brand": "workspace:*",
        "browserslist": "4.29.5",
        "postcss": "8.5.32",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "serve": "14.2.8",
        "tailwindcss": "4.3.5",
        "tailwindcss-animate": "1.0.7",
        "tsup": "9.0.0",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "dependencies": {
        "axe-core": "4.14.0",
        "modern-screenshot": "4.7.0",
        "prosemirror-commands": "1.7.2",
        "prosemirror-history": "1.5.1",
        "prosemirror-inputrules": "1.5.1",
        "prosemirror-keymap": "1.2.3",
        "prosemirror-model": "1.25.13",
        "prosemirror-schema-list": "1.6.0",
        "prosemirror-state": "1.4.4",
        "prosemirror-transform": "1.12.5",
        "prosemirror-view": "1.42.9"
    }
}
